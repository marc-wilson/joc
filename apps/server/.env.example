# Copy to .env and fill in. .env is git-ignored.

# MongoDB connection string, e.g. from Atlas: mongodb+srv://<user>:<password>@<cluster>/joc
MONGODB_URI=

PORT=3000

# GitHub sign-in. Leave empty for local dev: everything stays open and belongs to `local`.
# With the JOC GitHub App, these are the App's client id and secret (docs/github-app.md). To try
# sign-in locally, use a separate development app whose callback is
# http://localhost:5173/auth/github/callback.
JOC_GITHUB_CLIENT_ID=
JOC_GITHUB_CLIENT_SECRET=
# Where the dashboard is reached, for the OAuth callback (local dev: http://localhost:5173).
JOC_PUBLIC_URL=

# The JOC GitHub App (docs/github-app.md): its webhooks bring pull requests, reviews, CI and
# comments. Leave empty to have each machine's plugin read GitHub through `gh` instead.
JOC_GITHUB_WEBHOOK_SECRET=
JOC_GITHUB_APP_ID=
# The App's private key: the PEM, the PEM with `\n` for newlines, or the PEM base64-encoded.
JOC_GITHUB_APP_PRIVATE_KEY=
# The App's slug (github.com/apps/<slug>), for the Install link. Read from GitHub when the App
# id and key are set; only needed without them.
JOC_GITHUB_APP_SLUG=

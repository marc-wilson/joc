# Copy to .env and fill in. .env is git-ignored.

# MongoDB connection string, e.g. from Atlas: mongodb+srv://<user>:<password>@<cluster>/joc
MONGODB_URI=

PORT=3000

# Shared token for the API and dashboard. Leave empty for local dev: everything stays open.
# When set, the plugin sends it as JOC_TOKEN and the dashboard asks for it once.
JOC_TOKEN=
